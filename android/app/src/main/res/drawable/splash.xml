<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Ink Background -->
    <item>
        <color android:color="#0a0a0c" />
    </item>

    <!-- Centered Gold Velour Emblem -->
    <item
        android:width="100dp"
        android:height="100dp"
        android:gravity="center">
        <vector
            android:width="100dp"
            android:height="100dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <!-- Circular gold accent border -->
            <path
                android:fillColor="#16161a"
                android:strokeColor="#C6A85E"
                android:strokeWidth="1.5"
                android:pathData="M50,50 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0" />

            <!-- Luxury Serif 'V' Monogram -->
            <path
                android:fillColor="#C6A85E"
                android:pathData="M35,32 L46,32 L46,35 L43.5,35 L50.5,59 L54.5,59 L62,35 L59.5,35 L59.5,32 L67,32 L67,35 L64.5,35 L54.5,65 L48.5,65 L37.5,35 L35,35 Z" />
        </vector>
    </item>
</layer-list>
